<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(PRODUCT_APP_GROUP_IDENTIFIER)</string>
	</array>
	<!-- A Linux desktop runs dozens of guest processes, each with its own
	     address space and translation caches; the default iOS limits run out
	     (crash reports: "could not allocate TLB", allocation failures). -->
	<key>com.apple.developer.kernel.extended-virtual-addressing</key>
	<true/>
	<key>com.apple.developer.kernel.increased-memory-limit</key>
	<true/>
</dict>
</plist>
